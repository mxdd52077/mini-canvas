# Mini Canvas 唯一环境变量模板。
# 复制为 .env.local（npm 开发）或 .env（Docker / deploy.sh），再填写真实值。
# 不要把 .env、.env.local 或任何真实密钥提交到 Git。

# ── Supabase：云项目与自托管二选一 ──────────────────────────────
# 云项目：在 Supabase Dashboard 的 Connect / Settings > API Keys 获取。
# 自托管：URL 使用本地网关；三个 JWT 值运行 node deploy/gen-supabase-keys.mjs 生成。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 仅服务端使用，绝不能添加 NEXT_PUBLIC_ 前缀。
SUPABASE_SECRET_KEY=
# Docker 自托管时由 compose 固定为 http://kong:8000；普通部署通常留空。
SUPABASE_INTERNAL_URL=

# ── 浏览器与协作服务 ───────────────────────────────────────────
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:8787
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_PORT=3000
COLLABORATION_PORT=8787
MODEL_SYNC_INTERVAL_MS=86400000

# ── Seedance NZ：图片、视频、音频、Midjourney 与默认 AI 助手 ───
# 在 https://api.seedance.nz/keys 创建令牌。
SEEDANCE_API_KEY=
KIMI_BASE_URL=https://api.seedance.nz/v1
# 留空时复用 SEEDANCE_API_KEY。
KIMI_API_KEY=
KIMI_MODEL_ID=zhenzhen/g5.6-luna
SEEDANCE_SCENE_MODEL=zhenzhen/g5.6-luna

# ── 可选：火山方舟直连 ─────────────────────────────────────────
# VOLCENGINE_API_KEY 来自方舟控制台 API Key 管理。
# VOLCENGINE_ENDPOINT 填项目所使用的生成接口基础地址或接入点地址。
VOLCENGINE_API_KEY=
VOLCENGINE_ENDPOINT=

# ── 完整自托管 Supabase（docker-compose.selfhost.yml）──────────
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 以下三项由 node deploy/gen-supabase-keys.mjs 输出；生成后覆盖上面的两个 Supabase Key。
JWT_SECRET=
SUPABASE_API_PORT=8000
UPLOAD_FILE_SIZE_LIMIT=524288000
GLOBAL_S3_BUCKET=local-storage

# ── 构建网络，可选 ─────────────────────────────────────────────
NPM_REGISTRY=https://registry.npmjs.org
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
BUILD_HTTP_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1

# ── deploy.sh 远端发布，可选 ───────────────────────────────────
DEPLOY_HOST=example.com
DEPLOY_USER=deploy
DEPLOY_DIR=C:/opt/mini-canvas
SSH_PORT=22
# 留空时使用 ssh-agent / 系统默认密钥；也可以填写绝对路径。
SSH_KEY=
COMPOSE_FILE=docker-compose.selfhost.yml

# 预留字段；当前版本没有从数据库读取加密后的渠道密钥。
MODEL_ENCRYPTION_KEY=

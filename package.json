{
  "name": "mini-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "sync": "tsx server/collaboration.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "db:local": "wrangler d1 migrations apply mini-canvas --local",
    "db:remote": "wrangler d1 migrations apply mini-canvas --remote",
    "test:cloudflare": "node tests/cloudflare-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/paper": "0.12.3",
    "@types/ws": "8.18.1",
    "@vinext/cloudflare": "1.1.0",
    "concurrently": "10.0.5",
    "geist": "^1.7.2",
    "jsdom": "26.1.0",
    "lucide-react": "0.468.0",
    "nanoid": "6.0.1",
    "next": "16.3.5",
    "paper": "0.12.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "three": "^0.186.1",
    "tsx": "4.20.5",
    "typebox": "1.3.7",
    "vite": "8.3.4",
    "ws": "8.21.3",
    "zod": "4.1.11",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "5.20261010.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "1.1.0",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
